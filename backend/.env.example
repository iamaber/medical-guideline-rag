# Medical Advisor Environment Variables
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM Configuration (SIMPLE AND CLEAN)
# =============================================================================

# Select your LLM provider: openai, anthropic, google, zai, ollama, azure, deepseek
LLM_PROVIDER=zai

# Model name for your selected provider (examples below)
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-opus-20240229
# - Google: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# - z.ai: GLM-4.7, GLM-4-Flash, GLM-4-Air (check z.ai documentation)
# - Ollama: llama3.2, mistral, codellama, phi
# - Azure: your-deployment-name
# - DeepSeek: deepseek-chat, deepseek-coder
LLM_MODEL=GLM-4.7

# API Key for your selected provider (ONE field for all providers)
# Get your key from the provider's website:
# - z.ai: https://z.ai
# - OpenAI: https://platform.openai.com/api-keys
# - Google: https://console.cloud.google.com/apis/credentials
# - Anthropic: https://console.anthropic.com/settings/keys
# - DeepSeek: https://platform.deepseek.com
LLM_API_KEY=your_api_key_here

# =============================================================================
# Generation Settings (Optional)
# =============================================================================
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048
# LLM_TOP_P=0.8

# =============================================================================
# External API Keys (Non-LLM Services)
# =============================================================================

# Jina API (for web scraping)
# Get key from: https://jina.ai/
JINA_API_KEY=your_jina_api_key_here

# NCBI E-utilities API (Optional, for PubMed access)
# Get key from: https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here

# =============================================================================
# Application Settings (Optional)
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# Database Settings (Optional)
# =============================================================================
# Uncomment and modify if using custom paths
# DRUG_DB_PATH=data/drug_db/medex_URL.json
# PROCESSED_DIR=data/processed
# VECTOR_INDEX_PATH=data/vector_index.faiss
