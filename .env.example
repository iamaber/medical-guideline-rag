# Medical Advisor Environment Variables
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Select your LLM provider: openai, anthropic, google, ollama, azure, deepseek
LLM_PROVIDER=google

# Model name for your selected provider (examples below)
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-opus-20240229
# - Google: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# - Ollama: llama3.2, mistral, codellama, phi
# - Azure: your-deployment-name
# - DeepSeek: deepseek-chat, deepseek-coder
LLM_MODEL=gemini-2.0-flash

# =============================================================================
# Provider API Keys (configure the one you need)
# =============================================================================

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
# Legacy alias (still supported for backwards compatibility)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (local - no API key required)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Generation Settings (Optional)
# =============================================================================
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048
# LLM_TOP_P=0.8

# =============================================================================
# NCBI E-utilities API (Optional, for PubMed access)
# =============================================================================
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here

# =============================================================================
# Application Settings (Optional)
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# =============================================================================
# Database Settings (Optional)
# =============================================================================
# Uncomment and modify if using custom paths
# DRUG_DB_PATH=data/drug_db/medex_URL.json
# PROCESSED_DIR=data/processed
# VECTOR_INDEX_PATH=data/vector_index.faiss
